# Copy to .env and fill in.

# Local SQLite database (file lives at prisma/dev.db). Leave as-is for local dev.
DATABASE_URL="file:./dev.db"

# 32-byte base64 key for encrypting data-source API keys at rest. Required.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_SOURCE_ENCRYPTION_KEY=""
