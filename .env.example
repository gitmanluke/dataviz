# Copy to .env and fill in.

# Local SQLite database (file lives at prisma/dev.db). Leave as-is for local dev.
DATABASE_URL="file:./dev.db"

# 32-byte base64 key for encrypting stored secrets (data-source + Anthropic
# keys) at rest. Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_SOURCE_ENCRYPTION_KEY=""

# Optional. Enables the LLM viz agent (chart selection from your wording).
# You can also set this in the app at /settings instead. Without it, DataViz
# falls back to built-in heuristics.
ANTHROPIC_API_KEY=""

# Google Sheets integration: OAuth client id/secret (Desktop app) + an API key
# are configured in the app at /settings, not here. See docs/google-sheets.md.
