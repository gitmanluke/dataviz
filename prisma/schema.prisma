// Local SQLite database. See docs/VISION.md for the persistence plan.
// Run `npm run db:migrate` after changing this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DataSource {
  id           String   @id @default(cuid())
  name         String
  description  String?
  type         String   @default("snowleopard") // "snowleopard" | "files"
  datafileId   String? // snowleopard only
  apiKeyCipher String? // snowleopard only — AES-256-GCM (lib/crypto.ts), never sent to the client
  status       String   @default("connected")
  createdAt    DateTime @default(now())
  widgets      Widget[]
}

model Setting {
  key   String @id
  value String // encrypted for secrets (see lib/crypto.ts)
}

model Dashboard {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  isFavorite  Boolean  @default(false)
  lastViewed  DateTime @default(now())
  createdAt   DateTime @default(now())
  widgets     Widget[]
}

model Widget {
  id          String    @id @default(cuid())
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  type        String
  title       String
  data        String    @default("null") // JSON-serialized raw query rows
  spec        String? // JSON-serialized WidgetSpec (how to render `data`)
  // provenance — lets the widget be re-run against its source (file sources only)
  query        String?
  dataSourceId String?
  dataSource   DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  // react-grid-layout position/size
  x           Int       @default(0)
  y           Int       @default(0)
  w           Int       @default(4)
  h           Int       @default(3)
  minW        Int?
  minH        Int?
  createdAt   DateTime  @default(now())

  @@index([dashboardId])
}
