// Local SQLite database. See docs/VISION.md for the persistence plan.
// Run `npm run db:migrate` after changing this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DataSource {
  id           String   @id @default(cuid())
  name         String
  description  String?
  type         String   @default("snowleopard")
  datafileId   String
  apiKeyCipher String // AES-256-GCM payload (see lib/crypto.ts) — never sent to the client
  status       String   @default("connected")
  createdAt    DateTime @default(now())
}

model Dashboard {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  isFavorite  Boolean  @default(false)
  lastViewed  DateTime @default(now())
  createdAt   DateTime @default(now())
  widgets     Widget[]
}

model Widget {
  id          String    @id @default(cuid())
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  type        String
  title       String
  data        String    @default("null") // JSON-serialized raw query rows
  spec        String? // JSON-serialized WidgetSpec (how to render `data`)
  // react-grid-layout position/size
  x           Int       @default(0)
  y           Int       @default(0)
  w           Int       @default(4)
  h           Int       @default(3)
  minW        Int?
  minH        Int?
  createdAt   DateTime  @default(now())

  @@index([dashboardId])
}
